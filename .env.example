# PineLaunch secret settings: TEMPLATE ONLY. This file holds no real values.
#
# The real values go in a file named .env.local in this same folder.
# .env.local is ignored by Git. Never commit it, print it, paste it into a
# chat, or put it in a screenshot.
#
# These settings live on PineLaunch's own server. Students and parents never
# enter an API key and never create an AI account. PineLaunch pays for AI.

# Who answers AI requests. This one line is the whole switch.
#   mock       canned practice hints. No key, no cost. For development only:
#              the live site refuses it.
#   anthropic  the real API. Needs ANTHROPIC_API_KEY below.
# While developing, leaving it out means mock.
AI_PROVIDER=mock

# The Anthropic API key. Not needed while AI_PROVIDER is mock.
# A parent creates it in the Claude Console. It starts with sk-ant- and is
# shown only once.
ANTHROPIC_API_KEY=
